# 火山方舟（豆包）配置示例
# 复制成 .env.local 后填入自己的值；.env.local 已被 .gitignore 忽略，不会入库。
# 提示：界面右上角「设置」里填的 Key 优先级更高，日常用界面设置即可。

# 方舟 API Key（https://console.volcengine.com/ark 创建）
VITE_ARK_API_KEY=

# 文生图模型 ID（需在方舟控制台开通，如 doubao-seedream-5-0-260128）
VITE_ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

# 文案模型 ID（如 doubao-seed-2-0-mini-260428）
VITE_ARK_TEXT_MODEL=doubao-seed-2-0-mini-260428
